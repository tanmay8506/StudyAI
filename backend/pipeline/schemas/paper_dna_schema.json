{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperDNA",
  "description": "All four DNA analyses for a DU paper. Stored in papers.paper_dna column.",
  "type": "object",
  "required": ["structural_dna", "topic_dna", "language_dna", "combination_dna"],
  "properties": {

    "structural_dna": {
      "description": "Mechanical extraction of marks, sections, question structure. Generated by Groq (rule-based).",
      "type": "object",
      "required": ["total_marks", "sections", "question_distribution", "time_allowed_minutes"],
      "properties": {
        "total_marks": { "type": "integer" },
        "time_allowed_minutes": { "type": "integer" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section_label", "marks_per_question", "total_questions", "attempt_count"],
            "properties": {
              "section_label":      { "type": "string" },
              "marks_per_question": { "type": "integer" },
              "total_questions":    { "type": "integer" },
              "attempt_count":      { "type": "integer" },
              "compulsory":         { "type": "boolean" }
            }
          }
        },
        "question_distribution": {
          "description": "How many questions appear per unit across all PYQ years.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit_number", "appearances_across_years"],
            "properties": {
              "unit_number":             { "type": "integer" },
              "appearances_across_years": { "type": "integer" },
              "avg_marks_per_year":       { "type": "number" }
            }
          }
        },
        "attempt_all": { "type": "boolean" },
        "attempt":     { "type": "integer" }
      }
    },

    "topic_dna": {
      "description": "Per-topic appearance frequency, marks trends, and priority classification. Generated by Claude.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_name", "appearances", "total_appearances", "marks_trend", "priority", "never_asked", "recency_weight"],
        "properties": {
          "topic_name":       { "type": "string" },
          "appearances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["year", "marks", "question_type", "unit"],
              "properties": {
                "year":          { "type": "integer" },
                "marks":         { "type": "integer" },
                "question_type": { "type": "string" },
                "unit":          { "type": "integer" }
              }
            }
          },
          "total_appearances": { "type": "integer" },
          "marks_trend": {
            "type": "string",
            "enum": ["increasing", "stable", "decreasing", "single_appearance"]
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low", "never_asked"]
          },
          "never_asked":    { "type": "boolean" },
          "recency_weight": { "type": "number", "minimum": 1.0, "maximum": 1.5 }
        }
      }
    },

    "language_dna": {
      "description": "Exact examiner vocabulary and instruction-word frequency per topic. Generated by Claude.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_name", "instruction_words", "examiner_vocabulary", "typical_phrasing"],
        "properties": {
          "topic_name": { "type": "string" },
          "instruction_words": {
            "type": "object",
            "properties": {
              "find":      { "type": "integer" },
              "prove":     { "type": "integer" },
              "define":    { "type": "integer" },
              "state":     { "type": "integer" },
              "explain":   { "type": "integer" },
              "derive":    { "type": "integer" },
              "calculate": { "type": "integer" },
              "describe":  { "type": "integer" }
            }
          },
          "examiner_vocabulary": {
            "type": "array",
            "description": "Exact repeated phrases from question texts — verbatim.",
            "items": { "type": "string" }
          },
          "typical_phrasing": {
            "type": "string",
            "description": "Most common full question phrasing, verbatim."
          }
        }
      }
    },

    "combination_dna": {
      "description": "Cross-topic combination patterns — which topics are always asked together. Generated by Claude.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_name", "always_asked_with", "combination_pattern", "standalone_frequency", "diagram_required", "numerical_always"],
        "properties": {
          "topic_name":          { "type": "string" },
          "always_asked_with":   { "type": "array", "items": { "type": "string" } },
          "combination_pattern": { "type": "string" },
          "standalone_frequency":{ "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "diagram_required":    { "type": "boolean" },
          "numerical_always":    { "type": "boolean" }
        }
      }
    }

  }
}